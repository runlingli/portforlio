# --- 依赖与构建 (Dependencies & Build) ---
node_modules/
dist/
dist-ssr/
*.local

# --- 环境变量 (Environment Variables) ---
# 极其重要：不要把密钥提交到 GitHub
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- 日志与缓存 (Logs & Caches) ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*
.eslintcache
.stylelintcache
.vite
.turbo

# --- 编辑器私有配置 (Editor specific) ---
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- 系统文件 (System files) ---
.DS_Store
Thumbs.db

# --- 测试与覆盖率 (Testing) ---
/coverage
/test-results

# --- 类型脚本 (TypeScript) ---
# 如果你使用 tsconfig.tsbuildinfo 来加速构建，通常不需要提交它
*.tsbuildinfo